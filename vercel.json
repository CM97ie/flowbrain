{
  "outputDirectory": ".",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "manifest2.json", "use": "@vercel/static" },
    { "src": "sw-push.js", "use": "@vercel/static" },
    { "src": "icons/**", "use": "@vercel/static" },
    { "src": "api/send-notifications.js", "use": "@vercel/node" },
    { "src": "api/subscribe.js", "use": "@vercel/node" },
    { "src": "api/sync.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/manifest2.json", "dest": "/manifest2.json" },
    { "src": "/sw-push.js", "dest": "/sw-push.js", "headers": { "Service-Worker-Allowed": "/" } },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-notifications", "schedule": "* * * * *" }
  ]
}
